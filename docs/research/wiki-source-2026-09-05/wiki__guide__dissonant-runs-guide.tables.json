      [
        "Cannon",
        "AD (Astral Deliverance)",
        "AS (Amplifying Strike) in the secondary slot \u2014 or possibly Havoc Bringer (untested, but since enemies die very fast, instantly maxing Rend might be very strong). Substats: max Bounce Chance and Bounce Targets first, then whatever adds the most damage elsewhere."
      ],
      [
        "Armor",
        "SD (Space Displacer)",
        "ACP in the sub slot. Substats: prioritize Shockwave Cooldown and Shockwave Size \u2014 aim for 200+ range and 4+ shockwave size. Round out with Death Defy and orb-related substats."
      ],
      [
        "Generator",
        "PF (Project Funding)",
        "Either SH or PH depending on bot quality \u2014 PH is excellent in tournaments, but here you have little time to land shots, so SH (max bot coverage) is generally the better pick unless your bots aren't strong."
      ],
      [
        "Core",
        "Magnetic Hook",
        "Substats don't matter for this slot."
      ],
      [
        "Chip",
        "Scout",
        "Boosts damage substantially."
      ]
    ]
